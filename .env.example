# Django settings
# Generate a new secret key for production: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,storefrontCatalogService,storefrontCatalogServiceFrontend

# ============================================================================
# Kafka Cluster Settings (KRaft mode - no Zookeeper)
# ============================================================================
# For container-to-container communication (Django app inside Docker):
KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-2:9092,kafka-3:9092

# For local development OUTSIDE Docker (running Django locally):
# KAFKA_BOOTSTRAP_SERVERS=localhost:29092,localhost:29093,localhost:29094

# ============================================================================
# PostgreSQL Settings
# ============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=storefront_catalog

# Direct PostgreSQL connection (used for migrations)
POSTGRES_HOST=postgres_storefront_catalog_service
POSTGRES_PORT=5432

# ============================================================================
# Celery / RabbitMQ Settings
# ============================================================================
# For container-to-container communication (Django app inside Docker):
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//

# For local development OUTSIDE Docker (running Django locally):
# CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# ============================================================================
# ClickHouse Settings
# ============================================================================
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_secret

# ============================================================================
# PgBouncer Settings (Connection Pooling)
# ============================================================================
# Set USE_PGBOUNCER=false when running migrations
USE_PGBOUNCER=true
PGBOUNCER_HOST=pgbouncer
PGBOUNCER_PORT=6432

# Pool Mode Options:
# - transaction: Best for web applications (releases connection after each transaction)
# - session: Connection held for entire session (like direct PostgreSQL)
# - statement: Connection released after each statement (limited use cases)
PGBOUNCER_POOL_MODE=transaction

# Connection Limits
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=50
PGBOUNCER_MIN_POOL_SIZE=10
